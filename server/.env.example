# DriveEasy Car Rental System - Server Environment Variables
# Copy this file to .env and adjust variables as required

# Server Listening Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# Allowed Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection URI
# Local MongoDB Community Server default port is 27017
MONGO_URI=mongodb://127.0.0.1:27017/driveeasy

# JSON Web Token Configuration (for Authentication in Stage 2/3)
JWT_SECRET=driveeasy_super_secret_jwt_key_cspit_charusat
JWT_EXPIRES_IN=7d
